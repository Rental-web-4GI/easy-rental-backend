<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="12-pricing-monthly-driver-dossier" author="easy-rental">
        <addColumn tableName="pricings">
            <column name="price_per_month" type="DECIMAL(19,2)"/>
        </addColumn>

        <addColumn tableName="drivers">
            <column name="cni_number" type="VARCHAR(50)"/>
            <column name="license_number" type="VARCHAR(50)"/>
            <column name="license_expiry" type="DATE"/>
            <column name="years_experience" type="INTEGER"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
