<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="17-support-visitor-session" author="easy-rental">
        <addColumn tableName="support_threads">
            <column name="visitor_session_id" type="VARCHAR(64)"/>
            <column name="visitor_role" type="VARCHAR(50)"/>
        </addColumn>
        <createIndex tableName="support_threads" indexName="idx_support_threads_session">
            <column name="visitor_session_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
