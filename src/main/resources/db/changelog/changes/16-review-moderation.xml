<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="16-review-moderation" author="easy-rental">
        <addColumn tableName="reviews">
            <column name="published" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="author_role" type="VARCHAR(50)"/>
        </addColumn>
        <createIndex tableName="reviews" indexName="idx_reviews_published_created">
            <column name="published"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
