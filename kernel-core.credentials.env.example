# Copier vers kernel-core.credentials.env à la racine de ce dépôt (easy-rental-backend).
# Fichier gitignoré — NE PAS COMMITER les secrets.

# --- Production kernel-core ---
KERNEL_BASE_URL=https://kernel-core.yowyob.com
KERNEL_TENANT_ID=11111111-1111-1111-1111-111111111111

# ClientApplication machine (headers serveur — backend uniquement)
KERNEL_CLIENT_ID=prod-platform-backend
KERNEL_API_KEY=<secret-fourni-par-devops>

# Compte admin plateforme (tests / bootstrap — MFA possible)
KERNEL_ADMIN_USERNAME=platform-admin
KERNEL_ADMIN_EMAIL=<email-pour-codes-mfa>
KERNEL_ADMIN_PASSWORD=<mot-de-passe>
